# the CIA's settings, which makerom reads: a New 3DS title with the extended
# memory and the fast clock, the services the game and libctru call, and the
# RomFS the .3dsx carries too (engine/mk/3ds.mk's 3ds-cia)

BasicInfo:
  Title                   : SA3DS
  ProductCode             : KTR-H-SA3D
  Logo                    : Homebrew

RomFs:
  RootPath                : $(ROMFS)

TitleInfo:
  # a New 3DS title, as KTR- games are: the HOME Menu launches a CTR title,
  # one the Old 3DS runs too, in the Old 3DS's 64 MB however its exheader
  # asks, where the game needs the New 3DS's 124 MB
  Platform                : SNAKE
  Category                : Application
  UniqueId                : 0xf5a31

Option:
  UseOnSD                 : true
  FreeProductCode         : true
  MediaFootPadding        : false
  EnableCrypt             : false
  EnableCompress          : true

AccessControlInfo:
  CoreVersion             : 2
  DescVersion             : 2
  ReleaseKernelMajor      : "02"
  ReleaseKernelMinor      : "33"
  UseExtSaveData          : false
  FileSystemAccess:
    - DirectSdmc
  IoAccessControl:
  IdealProcessor          : 0
  AffinityMask            : 1
  Priority                : 16
  # the system core's time the program may take, up to 80%, where a thread
  # runs there
  MaxCpu                  : 0xD0
  DisableDebug            : false
  EnableForceDebug        : false
  CanWriteSharedPage      : true
  CanUsePrivilegedPriority: false
  CanUseNonAlphabetAndNumber: true
  PermitMainFunctionArgument: true
  CanShareDeviceMemory    : true
  RunnableOnSleep         : false
  SpecialMemoryArrange    : true
  # as a New 3DS title's exheader is: the Old 3DS's standard 64 MB mode, and
  # the New 3DS's 124 MB, its 804 MHz, its L2 cache and its third core. an
  # Old 3DS mode other than the standard one is a developer unit's layout,
  # which a retail console restarts into to launch the title, and fails
  SystemModeExt           : 124MB
  CpuSpeed                : 804MHz
  EnableL2Cache           : true
  CanAccessCore2          : true
  SystemMode              : 64MB
  MemoryType              : Application
  HandleTableSize         : 0x200
  SystemCallAccess:
    ControlMemory: 1
    ExitProcess: 3
    CreateThread: 8
    ExitThread: 9
    SleepThread: 10
    SetThreadPriority: 12
    CreateMutex: 19
    ReleaseMutex: 20
    CreateSemaphore: 21
    ReleaseSemaphore: 22
    CreateEvent: 23
    SignalEvent: 24
    ClearEvent: 25
    CreateTimer: 26
    SetTimer: 27
    CancelTimer: 28
    ClearTimer: 29
    CreateMemoryBlock: 30
    MapMemoryBlock: 31
    UnmapMemoryBlock: 32
    CreateAddressArbiter: 33
    ArbitrateAddress: 34
    CloseHandle: 35
    WaitSynchronization1: 36
    WaitSynchronizationN: 37
    DuplicateHandle: 39
    GetSystemTick: 40
    GetHandleInfo: 41
    GetSystemInfo: 42
    GetProcessInfo: 43
    GetThreadInfo: 44
    ConnectToPort: 45
    SendSyncRequest: 50
    OpenProcess: 51
    OpenThread: 52
    GetProcessId: 53
    GetProcessIdOfThread: 54
    GetThreadId: 55
    GetResourceLimit: 56
    GetResourceLimitLimitValues: 57
    GetResourceLimitCurrentValues: 58
    GetThreadContext: 59
    Break: 60
    OutputDebugString: 61
    CreatePort: 71
    CreateSessionToPort: 72
    CreateSession: 73
    AcceptSession: 74
    ReplyAndReceive: 79
    InvalidateProcessDataCache: 82
    StoreProcessDataCache: 83
    FlushProcessDataCache: 84
    ControlProcessMemory: 112
    GetThreadPriority: 11
    GetThreadAffinityMask: 14
    SetThreadAffinityMask: 15
    GetThreadIdealProcessor: 16
    SetThreadIdealProcessor: 17
    GetCurrentProcessorNumber: 18
    Backdoor: 123
  InterruptNumbers:
  ServiceAccessControl:
    - APT:U
    - ac:u
    - am:net
    - boss:U
    - cam:u
    - cecd:u
    - cfg:nor
    - cfg:u
    - csnd:SND
    - dsp::DSP
    - frd:u
    - fs:USER
    - gsp::Gpu
    - gsp::Lcd
    - hid:USER
    - http:C
    - ir:rst
    - ir:u
    - ir:USER
    - mic:u
    - ndm:u
    - news:s
    - nwm::EXT
    - nwm::UDS
    - ptm:sysm
    - ptm:u
    - pxi:dev
    - soc:U
    - ssl:C
    - y2r:u

SystemControlInfo:
  SaveDataSize: 0KB
  RemasterVersion: 0
  StackSize: 0x40000
  Dependency:
    ac: 0x0004013000002402
    am: 0x0004013000001502
    boss: 0x0004013000003402
    camera: 0x0004013000001602
